# Postgres holding the NYC public-record tables this resolution runs over:
#   - HPD registrations/contacts (hpd_registrations, hpd_contacts)
#   - ACRIS deeds (multi-parcel co-conveyance)
#   - PLUTO (pluto_latest — building class, co-op/condo flags)
#   - wow.wow_portfolios — JustFix's Who Owns What clustering, for the paired benchmark
#
# The record-linkage layer (nlr) reads the same PG* vars via nlr.db.pg_conn.
PGHOST=localhost
PGPORT=5434
PGDATABASE=justfixwow
PGUSER=
PGPASSWORD=
